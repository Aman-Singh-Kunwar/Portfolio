# ==============================================================================
# Monorepo .gitignore — Root, Backend, Client, Admin, E2E
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment variables & secrets (Never commit secrets)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/client/.env
frontend/client/.env.*
!frontend/client/.env.example
frontend/admin/.env
frontend/admin/.env.*
!frontend/admin/.env.example
*.pem
*.key
*.cert

# Build outputs
dist/
**/dist/
dist-ssr/
*.tsbuildinfo

# Playwright & Automated Test Artifacts
playwright-report/
**/playwright-report/
test-results/
**/test-results/
blob-report/
**/blob-report/
playwright/.cache/
**/.cache/
coverage/
**/coverage/
.nyc_output/

# Local Database & Docker Storage Volumes
mongo-data/
redis-data/
data/db/
dump/

# Logs & Debugging
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Bundler & Framework Caches
.vite/
**/.vite/
.turbo/
.eslintcache
.parcel-cache

# Operating System & Editor Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs & Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Temporary & Scratch Files
*.tmp
*.temp
scratch/

#local docs
docs/HMAC_SESSION_AUTH.md
docs/REDIS_CACHING_TIER.md
docs/ZOD_VALIDATION_LAYER.md